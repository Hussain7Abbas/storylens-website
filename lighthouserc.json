{
	"ci": {
		"collect": {
			"staticDistDir": "out",
			"url": [
				"http://localhost/en/",
				"http://localhost/ar/",
				"http://localhost/en/privacy/",
				"http://localhost/en/pricing/",
				"http://localhost/ar/pricing/"
			],
			"numberOfRuns": 1,
			"settings": {
				"chromeFlags": "--headless --no-sandbox",
				"throttling": {
					"rttMs": 80,
					"throughputKbps": 4096,
					"requestLatencyMs": 80,
					"downloadThroughputKbps": 4096,
					"uploadThroughputKbps": 1024,
					"cpuSlowdownMultiplier": 4
				}
			}
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.9
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 1
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 1
					}
				],
				"cumulative-layout-shift": [
					"error",
					{
						"maxNumericValue": 0.05
					}
				],
				"largest-contentful-paint": [
					"error",
					{
						"maxNumericValue": 2000
					}
				]
			}
		},
		"upload": {
			"target": "filesystem",
			"outputDir": ".lighthouseci/reports"
		}
	}
}
