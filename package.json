{
 "name": "storylens-website",
 "version": "3.4.1",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build && bun deploy/security-headers.ts",
  "start": "serve out -l 3000",
  "lint": "biome check",
  "format": "biome check --write",
  "typecheck": "tsc --noEmit",
  "test:e2e": "playwright test",
  "test": "playwright test",
  "lhci": "lhci autorun",
  "deploy": "bash deploy/deploy.sh"
 },
 "dependencies": {
  "lucide-react": "^1.48.0",
  "next": "16.3.6",
  "next-intl": "^4.14.7",
  "next-mdx-remote": "^6.0.0",
  "react": "19.2.8",
  "react-dom": "19.2.8"
 },
 "devDependencies": {
  "@axe-core/playwright": "^4.13.0",
  "@biomejs/biome": "2.4.2",
  "@lhci/cli": "^0.15.1",
  "@playwright/test": "^1.63.0",
  "@tailwindcss/postcss": "^4",
  "@types/node": "^20",
  "@types/react": "^19",
  "@types/react-dom": "^19",
  "serve": "^14.2.6",
  "tailwindcss": "^4",
  "typescript": "^5"
 },
 "browserslist": [
  "chrome >= 111",
  "edge >= 111",
  "firefox >= 128",
  "safari >= 16.4",
  "ios_saf >= 16.4",
  "not dead"
 ],
 "packageManager": "bun@1.3.6",
 "ignoreScripts": [
  "sharp",
  "unrs-resolver"
 ],
 "trustedDependencies": [
  "sharp",
  "unrs-resolver"
 ]
}
